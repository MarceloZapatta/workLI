{
  "compilerOptions": {
    "lib": ["deno.ns", "dom"]
  },
  "permissions": {
    "read": [
      "./package.json"
    ]
  },
  "tasks": {
    "start": "deno run --allow-read --allow-write --allow-run --allow-env index.ts",
